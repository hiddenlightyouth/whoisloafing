# 공개 레포를 분석할 때 쓰는 GitHub 토큰 (Public repositories 읽기 전용, 만료 기간은 366일 이하로)
GITHUB_TOKEN=

# Gemini API 키 (기술 스택, 맡은 기능, 코드 스타일, 해설에 사용). https://aistudio.google.com/apikey 에서 발급해요.
GEMINI_API_KEY=

# 선택 값
# Gemini 모델 변경용. 기본값은 gemini-3.8-flash
# GEMINI_MODEL=gemini-3.8-flash
# 프로덕션(npm start)에서 Express 서버가 쓰는 포트. 기본값은 3001이고, 개발 서버는 항상 3001을 써요.
# PORT=3001
