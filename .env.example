# 공개 레포를 분석할 때 쓰는 GitHub 토큰 (Public repositories 읽기 전용, 만료 기간은 366일 이하로)
GITHUB_TOKEN=

# Gemini API 키 (기술 스택, 맡은 기능, 코드 스타일, 해설에 사용). https://aistudio.google.com/apikey 에서 발급해요.
GEMINI_API_KEY=

# Supabase (채팅 저장과 공유, AI 사용량 기록). 비워 두면 이 기능들만 꺼져요.
# 프로젝트를 만든 뒤 SQL Editor에서 supabase/schema.sql을 한 번 실행해요.
# service role 키는 서버에서만 쓰는 비밀 값이에요. 절대 VITE_ 로 시작하는 이름으로 넣지 마세요.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Analytics 4 측정 ID (G-로 시작). 브라우저에 공개되는 값이에요. 비워 두면 추적하지 않아요.
VITE_GA_MEASUREMENT_ID=

# 선택 값
# Gemini 모델 변경용. 기본값은 gemini-3.8-flash
# GEMINI_MODEL=gemini-3.8-flash
# 프로덕션(npm start)에서 Express 서버가 쓰는 포트. 기본값은 3001이고, 개발 서버는 항상 3001을 써요.
# PORT=3001
